---
/** Encadré « Source » : référence complète d'une source de sources.json. */
import { chargerContenu } from '../lib/contenu';
import { libelleStatut, partiesReference } from '../lib/sources';

interface Props {
  id: string;
  precision?: string;
}
const { id, precision } = Astro.props;
const { sources } = await chargerContenu();
const s = sources.find((x) => x.id === id)?.data;
if (!s) throw new Error(`Source inconnue : ${id}`);
const statut = libelleStatut(s.statut);
const { avant, apres } = partiesReference(s);
const fin = precision ? `${apres} ${precision}.` : apres;
---

<p class="source">
  <strong>Source</strong> · {[avant, <cite>{s.titre}</cite>, fin]}
  {s.doi ? (
    <>
      {' '}
      <a href={`https://doi.org/${s.doi}`}>doi:{s.doi}</a>
    </>
  ) : (
    s.url && (
      <>
        {' '}
        <a href={s.url}>{s.url}</a>
      </>
    )
  )}
  {statut && <span class="etiquette">{statut}</span>}
</p>

<style>
  .source {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--c-texte-doux);
    border-left: 2px solid var(--c-bordure);
    padding: 0.1rem 0 0.1rem 0.7rem;
    margin: var(--espace-2) 0;
    max-width: var(--mesure);
  }
  .source strong {
    font-weight: 700;
  }
  .source a {
    color: var(--c-texte-doux);
  }
</style>
