---
/**
 * Terme technique cliquable vers le glossaire, suivi de son explication courte entre parenthèses.
 * Usage : <Definition terme="riasec" /> (affiche le terme du glossaire) ou
 * <Definition terme="facette" texte="facettes" /> (forme accordée).
 * Avec `seul`, n'affiche que la parenthèse (le terme figure déjà dans la phrase).
 */
import { definition, lienGlossaire, type TermeGlossaire } from '../lib/glossaire';

interface Props {
  terme: TermeGlossaire;
  texte?: string;
  seul?: boolean;
}
const { terme, texte, seul = false } = Astro.props;
const d = definition(terme);
const href = lienGlossaire(terme);
const libelle = texte ?? d.terme;
const parenthese = `(${d.court})`;
---

{
  // Balises sur une ligne : aucun espace parasite dans le lien ni avant la ponctuation.
  // prettier-ignore
  seul
    ? [<span class="definition">{['(', <a href={href}>{d.court}</a>, ')']}</span>]
    : [<a href={href} class="terme">{libelle}</a>, ' ', <span class="definition">{parenthese}</span>]
}
<style>
  .definition {
    color: var(--c-texte-doux);
  }
  .definition a {
    color: inherit;
  }
</style>
