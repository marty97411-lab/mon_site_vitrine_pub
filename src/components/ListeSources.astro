---
import type { CollectionEntry } from 'astro:content';

interface Props {
  sources: CollectionEntry<'sources'>[];
  titre?: string;
  /** Niveau du titre (2 par défaut) et identifiant unique, pour plusieurs listes sur une page. */
  niveau?: 2 | 3 | 4;
  idTitre?: string;
}

const { sources, titre = 'Sources', niveau = 2, idTitre = 'titre-sources' } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3' | 'h4';
---

{sources.length > 0 && (
  <section aria-labelledby={idTitre}>
    <Titre id={idTitre}>{titre}</Titre>
    <ul>
      {sources.map(({ data: s }) => (
        <li>
          {s.auteurs.join(', ')} ({s.annee ?? 's. d.'}). <cite>{s.titre}</cite>
          {s.publication && <>. {s.publication}</>}
          {s.volume && <>, {s.volume}</>}
          {s.pages && <>, {s.pages}</>}.
          {s.doi && (
            <>
              {' '}
              <a href={`https://doi.org/${s.doi}`}>doi:{s.doi}</a>
            </>
          )}
          {!s.doi && s.url && (
            <>
              {' '}
              <a href={s.url}>{s.url}</a>
            </>
          )}{' '}
          {s.statut === 'a-verifier' && <span class="etiquette">référence à vérifier</span>}
        </li>
      ))}
    </ul>
  </section>
)}
