---
/** Bloc dépliable « En savoir plus » / « Approfondir » (élément natif <details>, sans JavaScript). */
interface Props {
  titre?: string;
  ouvert?: boolean;
  id?: string;
}
const { titre = 'En savoir plus', ouvert = false, id } = Astro.props;
---

<details class="depliable" open={ouvert} id={id}>
  <summary>{titre}</summary>
  <div class="corps">
    <slot />
  </div>
</details>
