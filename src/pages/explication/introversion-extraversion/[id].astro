---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { chargerContenu } from '../../../lib/contenu';

export async function getStaticPaths() {
  const { introversion } = await chargerContenu();
  return introversion.map((page, i) => ({
    params: { id: page.id },
    props: { page, suivante: introversion[i + 1] },
  }));
}

const { page, suivante } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const base = '/explication/introversion-extraversion';
---

<Article
  titre={d.titre}
  description={d.description}
  badge={d.badge}
  essentiel={d.essentiel}
  comprendre={d.comprendre}
  corps={page.body}
  sources={d.sources}
  pourAllerPlusLoin={d.pour_aller_plus_loin}
  brouillon={d.brouillon}
  fil={[
    { libelle: 'Explication', href: '/explication' },
    { libelle: 'Introversion et extraversion', href: base },
    { libelle: d.titre },
  ]}
  illustration="bulles"
>
  <nav slot="apres-comprendre" class="suite" aria-label="Dossier introversion et extraversion">
    <a href={base}>Sommaire du dossier</a>
    {suivante && <a href={`${base}/${suivante.id}`}>Page suivante : {suivante.data.titre}</a>}
  </nav>
  <Content />
</Article>

<style>
  .suite {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2) var(--espace-4);
    font-weight: 700;
  }
</style>
