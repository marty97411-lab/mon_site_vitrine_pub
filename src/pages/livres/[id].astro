---
import Base from '../../layouts/Base.astro';
import Essentiel from '../../components/Essentiel.astro';
import EnSavoirPlus from '../../components/EnSavoirPlus.astro';
import { chargerContenu } from '../../lib/contenu';
import { lienAmazon, lienBnf } from '../../lib/isbn';
import { LIBELLES_ETIQUETTES, LIBELLES_THEMES } from '../../lib/schemas';
import { segmenterItalique } from '../../lib/texte';

export async function getStaticPaths() {
  const { livres } = await chargerContenu();
  return livres.map((livre) => ({ params: { id: livre.data.id }, props: { livre } }));
}

const { livre } = Astro.props;
const l = livre.data;
const requete = l.isbn ?? `${l.titre} ${l.auteurs.join(' ')}`;
/** Affiche les adresses encodées (%C3%A9…) sous une forme lisible. */
const lisible = (texte: string) => {
  try {
    return decodeURI(texte);
  } catch {
    return texte;
  }
};
const rd = l.resume_detaille;
const parties = rd
  ? [
      { titre: 'Les idées principales', paragraphes: rd.idees_principales },
      { titre: 'Ce que vous pouvez en retenir', paragraphes: rd.a_retenir },
      {
        titre: `Limites à garder en tête${rd.livre_discute ? ' (livre discuté)' : ''}`,
        paragraphes: rd.limites,
      },
    ]
  : [];
const description = `${l.titre}, de ${l.auteurs.join(', ')} (${l.editeur}, ${l.annee}) : résumé, pour qui, limites.`;
---

<Base
  titre={l.titre}
  description={description}
  fil={[{ libelle: 'Livres conseillés', href: '/livres' }, { libelle: l.titre }]}
  typeOg="article"
>
  <p class="haut">
    <span class:list={['etiquette-livre', l.etiquette]}>{LIBELLES_ETIQUETTES[l.etiquette]}</span>
    <span class="discret">
      {l.niveau === 'accessible' ? 'Lecture accessible' : 'Lecture exigeante'}
    </span>
  </p>
  <h1>{l.titre}</h1>
  {l.sous_titre && <p class="sous-titre">{l.sous_titre}</p>}
  <p class="discret">
    {l.auteurs.join(', ')}
    {l.direction && ' (dir.)'}
    {l.traducteurs.length > 0 && <> · traduction : {l.traducteurs.join(', ')}</>} · {l.editeur},{' '}
    {l.annee}
    {l.isbn && <> · ISBN {l.isbn}</>}
    {l.langue === 'en' && <> · en anglais</>}
  </p>
  {l.brouillon && (
    <p class="avertissement">
      <strong>Fiche à relire.</strong> Résumé et commentaires rédigés par l'équipe, en cours de
      relecture.
    </p>
  )}

  <Essentiel>
    <p>{l.resume}</p>
    {/* « Pour qui » : le texte commence déjà par « Pour qui… » ou « Pour les… ». */}
    <p class="pour-qui">{l.pour_qui}</p>
  </Essentiel>

  <div class="lecture">
    <EnSavoirPlus titre="Résumé détaillé" id="resume-detaille">
      {rd ? (
        parties.map((partie) => (
          <>
            <h2 class="partie-resume">{partie.titre}</h2>
            {partie.paragraphes.map((paragraphe) => (
              <p>
                {segmenterItalique(paragraphe).map((s) =>
                  s.italique ? <em>{s.texte}</em> : s.texte,
                )}
              </p>
            ))}
          </>
        ))
      ) : (
        <p class="discret">Le résumé détaillé de ce livre est en cours de rédaction.</p>
      )}
    </EnSavoirPlus>
  </div>

  <section class="lecture">
    <div class="a-garder">
      <h2>Ce qu'il faut garder en tête</h2>
      <p>{l.a_garder_en_tete}</p>
    </div>
    {l.note_controverse && (
      <p class="avertissement">
        <strong>Livre discuté.</strong> {l.note_controverse}
      </p>
    )}
    <p class="discret">Thèmes : {l.themes.map((t) => LIBELLES_THEMES[t]).join(', ')}.</p>
  </section>

  <div class="actions">
    {l.lien && (
      <a class="bouton" href={l.lien.url}>
        {l.lien.libelle}
      </a>
    )}
    <a class="bouton secondaire" href={lienBnf(requete)}>
      Chercher dans le catalogue de la BnF
    </a>
    {!l.domaine_public && (
      <a class="bouton secondaire" href={lienAmazon(requete)}>
        Chercher sur Amazon
      </a>
    )}
  </div>
  <p class="discret">
    Liens de recherche, sans affiliation : le site ne touche aucune commission et n'envoie aucune
    donnée.
  </p>

  <div class="lecture">
    <EnSavoirPlus titre="Approfondir : vérification de cette fiche">
      <p>Fiche vérifiée le {l.verification.date} à partir de :</p>
      <ul class="preuves">
        {l.verification.preuves.map((p) => (
          <li>{lisible(p)}</li>
        ))}
      </ul>
      {l.verification.reste_a_verifier && (
        <p>Reste à vérifier : {l.verification.reste_a_verifier}</p>
      )}
      {l.note_edition && <p>Édition : {l.note_edition}</p>}
    </EnSavoirPlus>
  </div>
  <p>
    <a href="/livres">Voir tous les livres conseillés</a>
  </p>
</Base>

<style>
  .haut {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    align-items: center;
    margin-top: var(--espace-4);
  }
  /* « Pour qui » : ligne courte dans « L'essentiel », sous le bref résumé. */
  :global(.contenu) .pour-qui {
    font-size: 0.95rem;
    border-top: 1px solid currentColor;
    padding-top: var(--espace-2);
    margin-top: var(--espace-2);
  }
  /* Partie secondaire, discrète comme les encadrés « Source » (≥ 15 px, contraste AA). */
  .a-garder {
    font-size: max(0.85rem, 15px);
    line-height: 1.5;
    color: var(--c-texte-doux);
    border-left: 2px solid var(--c-bordure);
    padding: 0.1rem 0 0.1rem 0.7rem;
    margin: var(--espace-3) 0;
  }
  .a-garder h2 {
    font-family: var(--police-texte);
    font-size: 1em;
    font-weight: 700;
    color: inherit;
    margin: 0 0 var(--espace-1);
  }
  .a-garder p {
    margin: 0;
  }
  .partie-resume {
    font-size: 1.2rem;
    margin-top: var(--espace-4);
  }
  .preuves li {
    overflow-wrap: anywhere;
  }
  .sous-titre {
    font-family: var(--police-titre);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.2rem;
    color: var(--c-texte-doux);
    margin-top: 0;
  }
  .etiquette-livre {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.15rem 0.65rem;
    border-radius: var(--rayon-pilule);
  }
  .recherche {
    background: var(--c-science-fond);
    color: var(--c-science);
  }
  .philosophie {
    background: var(--c-reflexion-fond);
    color: var(--c-reflexion);
  }
  .temoignage {
    background: var(--c-primaire-clair);
    color: var(--c-primaire-fonce);
  }
</style>
