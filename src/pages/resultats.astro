---
import Definition from '../components/Definition.astro';
import Base from '../layouts/Base.astro';
import Avertissement from '../components/Avertissement.astro';
import Badge from '../components/Badge.astro';
import Illustration from '../components/Illustration.astro';
import ListeSources from '../components/ListeSources.astro';
import QuestionSituation from '../components/QuestionSituation.astro';
import { catalogueArticles, chargerContenu, sourcesParIds } from '../lib/contenu';
import { jobZonesSchema, LIBELLES_ETIQUETTES } from '../lib/schemas';
import { SEUIL_FORTE, SEUIL_TRES_FORTE } from '../lib/rapprochement';
import jobZonesJson from '../data/onet/job-zones.json';
import recommandationsJson from '../data/recommandations.json';

const contenu = await chargerContenu();
// Les zones 1 et 2 sont regroupées dans O*NET 31.0 : une seule ligne pour les deux.
const zones = jobZonesSchema
  .parse(jobZonesJson)
  .zones.filter((z, i, toutes) => toutes.findIndex((x) => x.nom_original === z.nom_original) === i);
const virgule = (n: number) => n.toLocaleString('fr-FR', { maximumFractionDigits: 3 });
// Données minimales transmises au script client.
const donnees = {
  parcours: contenu.parcours.map(({ data: p }) => ({
    id: p.id,
    nom: p.nom,
    precision: p.precision,
    questionnaires: p.questionnaires,
  })),
  questionnaires: contenu.questionnaires.map(({ data: q }) => ({
    id: q.id,
    nom: q.nom,
    modele: q.modele,
    echelle: { min: q.echelle.min, max: q.echelle.max },
    agregation: q.agregation,
    seuil_completude: q.seuil_completude,
    avec_facettes: q.avec_facettes,
    items: q.items.map((i) => ({ id: i.id, domaine: i.domaine, facette: i.facette, cle: i.cle })),
  })),
  traits: contenu.traits.map(({ id, data }) => ({ trait: data.trait, nom: data.nom, fiche: id })),
  recommandations: recommandationsJson,
  articles: catalogueArticles(contenu),
  livres: Object.fromEntries(
    contenu.livres.map(({ data: l }) => [
      l.id,
      {
        titre: l.titre,
        auteurs: l.auteurs.join(', '),
        etiquette: LIBELLES_ETIQUETTES[l.etiquette],
      },
    ]),
  ),
};
---

<Base
  titre="Vos résultats"
  description="Votre profil de personnalité, vos intérêts professionnels et des familles de métiers proches."
  fil={[{ libelle: 'Le test', href: '/parcours' }, { libelle: 'Vos résultats' }]}
>
  <header class="tete-resultats">
    <Illustration variante="chemin" class="deco" />
    <p>
      <Badge type="science" />
    </p>
    <h1>Vos résultats</h1>
    <p class="discret">
      Une photographie de qui vous êtes aujourd'hui. Pas un verdict : un point de départ pour
      réfléchir.
    </p>
  </header>
  <Avertissement />
  <div id="resultats" aria-live="polite">
    <p>
      Aucun résultat à afficher dans ce navigateur. <a href="/parcours">Choisir un parcours</a>{' '}
      (JavaScript nécessaire).
    </p>
  </div>
  <QuestionSituation />
  <p>
    <button class="bouton secondaire" type="button" id="effacer">
      Effacer toutes mes réponses et notes de ce navigateur
    </button>
  </p>

  <!-- Explications insérées par le script dans la section des métiers. -->
  <template id="explication-correspondance">
    <p>
      Le niveau de correspondance indique à quel point vos intérêts ressemblent à ceux qui
      caractérisent un métier. Ce n'est ni une note, ni une probabilité de réussite.
    </p>
    <details class="depliable">
      <summary>En savoir plus sur la correspondance</summary>
      <h3>Ce que signifie le niveau affiché</h3>
      <ul>
        <li>
          <strong>Correspondance très forte</strong> : vos intérêts les plus marqués et les moins
          marqués sont très proches de ceux du métier (corrélation d'au moins{' '}
          {virgule(SEUIL_TRES_FORTE)}).
        </li>
        <li>
          <strong>Correspondance forte</strong> : ressemblance nette, un peu moins étroite (de
          {virgule(SEUIL_FORTE)} à {virgule(SEUIL_TRES_FORTE - 0.001)}).
        </li>
        <li>
          <strong>Correspondance modérée</strong> : ressemblance partielle (de 0 à
          {virgule(SEUIL_FORTE - 0.001)}). Ce n'est pas un avis défavorable.
        </li>
      </ul>
      <p>Les métiers dont le profil est à l'opposé du vôtre ne sont pas proposés.</p>
      <h3>Comment il est calculé</h3>
      <p>
        Votre profil d'intérêts se compose de vos six scores RIASEC (Réaliste, Investigateur,
        Artistique, Social, Entreprenant, Conventionnel). Chaque métier a lui aussi un profil de six
        scores dans la base américaine <Definition terme="onet" /> (version 31.0). Le site compare
        la <em>forme</em> des deux profils : quelles dimensions sont hautes et lesquelles sont
        basses, chez vous et dans le métier. Le niveau de vos scores ne compte pas, seulement leur
        ordre et leurs écarts. Cette comparaison (une <Definition terme="correlation" />) et les
        seuils ci-dessus sont ceux du manuel de l'O*NET Interest Profiler.
      </p>
      <p>
        Les profils des métiers sont estimés par O*NET par apprentissage automatique contrôlé par
        des experts. Les seuils ont été établis pour des profils notés par des experts ; le site les
        applique tels quels.
      </p>
      <h3>Ce qu'il ne veut pas dire</h3>
      <ul>
        <li>Ce n'est pas une garantie de réussite ni d'épanouissement dans le métier.</li>
        <li>
          Il ne tient compte ni de vos compétences, ni de vos diplômes, ni de votre expérience, ni
          de votre personnalité.
        </li>
        <li>
          Il ne dit rien de l'accès au métier ni de l'emploi en France : les données décrivent des
          métiers américains.
        </li>
      </ul>
      <ListeSources
        sources={sourcesParIds(contenu, ['onet-ip-manual-2021', 'onet-31'])}
        titre="Sources"
        niveau={3}
        idTitre="sources-correspondance"
      />
    </details>
  </template>

  <template id="explication-preparation">
    <p>
      Le niveau de préparation indique la formation et l'expérience habituellement demandées pour le
      métier aux États-Unis. L'équivalent français indiqué entre parenthèses est approximatif.
    </p>
    <details class="depliable">
      <summary>En savoir plus sur les niveaux de préparation</summary>
      <p>
        La base O*NET classe les métiers en <Definition terme="job-zone" texte="« Job Zones »" />,
        de 1 (peu de préparation) à 5 (préparation très importante). Dans la version 31.0 utilisée
        ici, les zones 1 et 2 sont regroupées.
      </p>
      <div
        class="tableau-defilant"
        tabindex="0"
        role="region"
        aria-label="Tableau des niveaux de préparation"
      >
        <table>
          <caption>Niveaux de préparation O*NET et équivalence indicative en France</caption>
          <thead>
            <tr>
              <th scope="col">Niveau</th>
              <th scope="col">Ce que décrit O*NET (États-Unis)</th>
              <th scope="col">Équivalence indicative en France</th>
            </tr>
          </thead>
          <tbody>
            {zones.map((z) => (
              <tr>
                <th scope="row">
                  {z.nom}{' '}
                  <span class="discret" lang="en">
                    ({z.nom_original})
                  </span>
                </th>
                <td>{z.description}</td>
                <td>{z.equivalence_fr}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="avertissement">
        <strong>Équivalence approximative.</strong> Elle est proposée par le projet : aucune table
        de correspondance officielle entre les niveaux O*NET et les diplômes français n'a été
        trouvée. Les données décrivent le système de formation américain, et les conditions d'accès
        en France (diplômes, concours, professions réglementées) peuvent être très différentes.
      </p>
      <ListeSources
        sources={sourcesParIds(contenu, ['onet-31', 'cadre-national-certifications-2019'])}
        titre="Sources"
        niveau={3}
        idTitre="sources-preparation"
      />
    </details>
  </template>
</Base>

<script
  is:inline
  id="donnees-resultats"
  type="application/json"
  set:html={JSON.stringify(donnees)}
/>
<script>
  import metiersOnet from '../data/onet/metiers.json';
  import famillesOnet from '../data/onet/familles.json';
  import jobZonesOnet from '../data/onet/job-zones.json';
  import { FACETTES, RIASEC, RIASEC_NOMS, type FacetteId, type TraitId } from '../lib/big-five';
  import {
    calculerProfil,
    codeRiasec,
    compterReponses,
    profilRiasec,
    type ConfigCotation,
  } from '../lib/scoring';
  import { LIBELLES_NIVEAU, rapprocher, regrouperParFamille } from '../lib/rapprochement';
  import { pointsProfil, pourcentageBarre, sommet, versAttribut } from '../lib/visualisation';
  import { effacerTout, lireEtat } from '../lib/stockage';
  import { suggerer, type ProfilPourSuggestions } from '../lib/recommandations';
  import { GLOSSAIRE } from '../lib/glossaire';
  import type { ConfigRecommandations } from '../lib/schemas/recommandations';

  interface QuestionnaireClient extends ConfigCotation {
    id: string;
    nom: string;
    modele: 'big-five' | 'riasec';
    avec_facettes: boolean;
  }
  interface DonneesResultats {
    parcours: { id: string; nom: string; precision: string; questionnaires: string[] }[];
    questionnaires: QuestionnaireClient[];
    traits: { trait: TraitId; nom: string; fiche: string }[];
    recommandations: ConfigRecommandations;
    articles: Record<string, { titre: string; url: string; badge: string }>;
    livres: Record<string, { titre: string; auteurs: string; etiquette: string }>;
  }

  const donnees = JSON.parse(
    document.querySelector('#donnees-resultats')?.textContent ?? '{}',
  ) as DonneesResultats;
  const zone = document.querySelector<HTMLElement>('#resultats');
  const fmt = (n: number, d = 1) =>
    n.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });

  /** Petit utilitaire de création d'éléments (textes insérés via textContent, jamais en HTML). */
  function el<K extends keyof HTMLElementTagNameMap>(
    balise: K,
    attributs: Record<string, string> = {},
    ...enfants: (Node | string | null)[]
  ): HTMLElementTagNameMap[K] {
    const e = document.createElement(balise);
    for (const [k, v] of Object.entries(attributs)) e.setAttribute(k, v);
    for (const enfant of enfants) if (enfant !== null) e.append(enfant);
    return e;
  }

  /** Copie le contenu d'un <template> rendu côté serveur (explications et sources). */
  function cloner(id: string): Node {
    const modele = document.getElementById(id);
    return modele instanceof HTMLTemplateElement
      ? modele.content.cloneNode(true)
      : document.createTextNode('');
  }

  function lien(href: string, texte: string) {
    return el('a', { href }, texte);
  }

  const SVG = 'http://www.w3.org/2000/svg';
  function svg(balise: string, attributs: Record<string, string> = {}, ...enfants: Node[]) {
    const e = document.createElementNS(SVG, balise);
    for (const [k, v] of Object.entries(attributs)) e.setAttribute(k, v);
    e.append(...enfants);
    return e;
  }

  /** Barre horizontale d'un score moyen (1 à 5), avec repère du milieu de l'échelle. */
  function barre(nom: Node | string, valeur: number | null, niveau: 'trait' | 'facette') {
    const ligne = el('div', { class: `barre-ligne ${niveau}` });
    const entete = el('div', { class: 'barre-entete' });
    entete.append(
      el('span', { class: 'barre-nom' }, nom),
      el('span', { class: 'barre-valeur' }, valeur === null ? '—' : `${fmt(valeur)} / 5`),
    );
    const piste = el('div', { class: 'barre-piste', 'aria-hidden': 'true' });
    if (valeur !== null) {
      piste.append(
        el('span', { class: 'barre-remplie', style: `width:${pourcentageBarre(valeur, 1, 5)}%` }),
      );
    }
    ligne.append(entete, piste);
    return ligne;
  }

  /**
   * Lien contextuel vers le dossier « Introversion et extraversion ». Les seuils 2,5 et 3,5
   * (les mêmes que pour les suggestions de lecture) choisissent seulement la page proposée :
   * ils ne définissent aucune catégorie.
   */
  function lienDossierExtraversion(valeur: number) {
    const base = '/explication/introversion-extraversion';
    const [debut, page, libelle] =
      valeur <= 2.5
        ? [
            'Votre position est plutôt du côté de l’introversion, ce qui n’est ni de la timidité ni un défaut. ',
            'idees-recues',
            'Idées reçues sur l’introversion',
          ]
        : valeur >= 3.5
          ? [
              'Votre position est plutôt du côté de l’extraversion. ',
              'travail-recherche',
              'Ce que dit la recherche sur le travail',
            ]
          : [
              'Votre position est vers le milieu de l’échelle. ',
              'ce-que-c-est',
              'Un continuum plutôt que deux camps',
            ];
    return el(
      'p',
      { class: 'discret lien-dossier' },
      debut,
      lien(`${base}/${page}`, libelle),
      ' · ',
      lien(base, 'tout le dossier'),
    );
  }

  function sectionPersonnalite(q: QuestionnaireClient, reponses: Record<string, number>) {
    const profil = calculerProfil(q, reponses);
    const section = el('section', {
      'aria-labelledby': 'titre-personnalite',
      class: 'carte-resultat',
    });
    section.append(
      el('h2', { id: 'titre-personnalite' }, 'Votre personnalité'),
      el(
        'p',
        { class: 'phrase-graphique' },
        `Vos cinq grands traits selon le Big Five (${GLOSSAIRE['big-five']}). Chaque barre montre votre position entre 1 et 5 : aucun côté n’est meilleur que l’autre. Le trait vertical marque le milieu de l’échelle, qui n’est pas la moyenne de la population. `,
        lien('/la-science#scores', 'Pourquoi pas de comparaison ?'),
      ),
    );
    const graphique = el('div', { class: 'barres', role: 'list' });
    for (const { trait, nom, fiche } of donnees.traits) {
      const s = profil.domaines[trait];
      if (!s) continue;
      const item = el('div', { role: 'listitem' });
      item.append(barre(lien(`/traits/${fiche}`, nom), s.valeur, 'trait'));
      if (q.avec_facettes) {
        const details = el(
          'details',
          { class: 'depliable facettes' },
          el('summary', {}, `Les 6 facettes (aspects plus précis de ce trait)`),
        );
        for (const [id, f] of Object.entries(FACETTES)) {
          if (f.trait !== trait) continue;
          details.append(
            barre(f.nomFr, profil.facettes[id as FacetteId]?.valeur ?? null, 'facette'),
          );
        }
        item.append(details);
      }
      if (trait === 'E' && s.valeur !== null) item.append(lienDossierExtraversion(s.valeur));
      graphique.append(item);
    }
    section.append(
      graphique,
      el(
        'div',
        { class: 'echelle', 'aria-hidden': 'true' },
        el('span', {}, '1'),
        el('span', {}, 'milieu'),
        el('span', {}, '5'),
      ),
    );
    if (!q.avec_facettes) {
      section.append(
        el(
          'p',
          { class: 'discret' },
          'Le parcours rapide ne mesure pas les facettes de personnalité.',
        ),
      );
    }
    return section;
  }

  function hexagone(scores: Record<(typeof RIASEC)[number], number>, max: number) {
    const R = 92;
    const texte = RIASEC.map((l) => `${RIASEC_NOMS[l].nomFr} ${scores[l]} sur ${max}`).join(', ');
    const titre = svg('title', { id: 'hex-titre' });
    titre.textContent = `Profil d’intérêts : ${texte}.`;
    const groupe = svg('g', { transform: 'translate(180 130)' });
    for (const part of [1, 0.5]) {
      groupe.append(
        svg('polygon', {
          points: versAttribut(RIASEC.map((_, i) => sommet(i, R * part))),
          class: part === 1 ? 'hex-fond' : 'hex-grille',
        }),
      );
    }
    RIASEC.forEach((_, i) => {
      const p = sommet(i, R);
      groupe.append(
        svg('line', { x1: '0', y1: '0', x2: String(p.x), y2: String(p.y), class: 'hex-grille' }),
      );
    });
    groupe.append(
      svg('polygon', { points: versAttribut(pointsProfil(scores, max, R)), class: 'hex-profil' }),
    );
    RIASEC.forEach((l, i) => {
      const p = sommet(i, R + 16);
      const ancre = Math.abs(p.x) < 1 ? 'middle' : p.x > 0 ? 'start' : 'end';
      const t = svg('text', {
        x: String(p.x),
        y: String(p.y + (p.y > 0 ? 12 : p.y < -R ? -2 : 4)),
        'text-anchor': ancre,
        class: 'hex-libelle',
      });
      t.textContent = RIASEC_NOMS[l].nomFr;
      groupe.append(t);
    });
    return svg(
      'svg',
      { viewBox: '0 0 360 260', role: 'img', 'aria-labelledby': 'hex-titre', class: 'hexagone' },
      titre,
      groupe,
    );
  }

  function sectionInterets(q: QuestionnaireClient, reponses: Record<string, number>) {
    const section = el('section', { 'aria-labelledby': 'titre-interets', class: 'carte-resultat' });
    section.append(el('h2', { id: 'titre-interets' }, 'Vos intérêts professionnels'));
    const profil = calculerProfil(q, reponses);
    const scores = profilRiasec(profil);
    if (!scores) {
      section.append(el('p', {}, 'Profil d’intérêts incomplet.'));
      return { section, scores: null };
    }
    const max = profil.domaines['R']?.max ?? 0;
    const { code, egalite } = codeRiasec(scores);
    section.append(
      el(
        'p',
        { class: 'phrase-graphique' },
        `Votre profil selon le modèle RIASEC (${GLOSSAIRE.riasec}). Plus une pointe s’éloigne du centre, plus cette famille d’activités vous attire. Votre code d’intérêts : `,
        el('strong', {}, code),
        '.',
      ),
      hexagone(scores, max),
    );
    if (egalite) {
      section.append(
        el(
          'p',
          { class: 'discret' },
          'Certaines dimensions sont à égalité : l’ordre des lettres concernées est alors arbitraire. Choisissez celle dont les activités vous parlent le plus.',
        ),
      );
    }
    const details = el('details', { class: 'depliable' }, el('summary', {}, 'Voir les valeurs'));
    const table = el('table');
    table.append(
      el('caption', {}, `Score par dimension (somme des réponses, de 0 à ${max})`),
      el(
        'thead',
        {},
        el('tr', {}, el('th', { scope: 'col' }, 'Dimension'), el('th', { scope: 'col' }, 'Score')),
      ),
    );
    const corps = el('tbody');
    for (const l of RIASEC) {
      corps.append(
        el(
          'tr',
          {},
          el('th', { scope: 'row' }, `${RIASEC_NOMS[l].nomFr} (${l})`),
          el('td', {}, `${scores[l]} / ${max}`),
        ),
      );
    }
    table.append(corps);
    details.append(
      table,
      el('p', {}, lien('/explication/interets', 'Que signifient les six dimensions ?')),
    );
    section.append(details);
    return { section, scores };
  }

  function sectionMetiers(scores: Record<(typeof RIASEC)[number], number>) {
    const section = el('section', { 'aria-labelledby': 'titre-metiers' });
    section.append(
      el('h2', { id: 'titre-metiers' }, 'Familles de métiers proches de vos intérêts'),
      el(
        'p',
        {},
        'Ces pistes comparent la forme de votre profil d’intérêts à celle de 923 métiers de la base O*NET, selon la méthode de l’O*NET Interest Profiler. Il n’y a pas de « métier idéal » : ce sont des idées à explorer. ',
      ),
      cloner('explication-correspondance'),
    );
    const resultat = rapprocher(scores, metiersOnet.metiers);
    if (resultat.statut === 'profil-plat') {
      section.append(
        el(
          'p',
          { class: 'avertissement' },
          'Toutes vos dimensions d’intérêts ont le même score : aucun rapprochement n’est possible. Si vous avez répondu de la même façon à toutes les activités, vos résultats ne reflètent peut-être pas vos intérêts ; vous pouvez reprendre le questionnaire à un autre moment.',
        ),
      );
      return section;
    }
    const familles = regrouperParFamille(resultat.correspondances, 5).slice(0, 6);
    const nomFamille = new Map(famillesOnet.familles.map((f) => [f.code, f]));
    const nomZone = new Map(
      jobZonesOnet.zones.map((z) => [z.zone, `${z.nom} (≈ ${z.equivalence_fr})`]),
    );
    const grille = el('div', { class: 'grille deux familles' });
    for (const f of familles) {
      const info = nomFamille.get(f.famille);
      const bloc = el('article', { class: 'famille' });
      bloc.append(
        el('span', { class: 'niveau' }, LIBELLES_NIVEAU[f.niveau]),
        el('h3', {}, info?.nom ?? f.famille),
        el(
          'p',
          { class: 'discret' },
          'Famille O*NET « ',
          el('span', { lang: 'en' }, info?.nom_original ?? ''),
          ' » · niveau du métier le plus proche',
        ),
      );
      const ul = el('ul');
      for (const c of f.metiers) {
        const zone = c.metier.job_zone === null ? '' : ` · ${nomZone.get(c.metier.job_zone) ?? ''}`;
        ul.append(
          el(
            'li',
            {},
            el(
              'a',
              { href: `https://www.onetonline.org/link/summary/${c.metier.code}`, lang: 'en' },
              c.metier.titre,
            ),
            ` (${c.metier.code}, code ${c.metier.code_riasec || '—'}) · ${LIBELLES_NIVEAU[c.niveau]}${zone}`,
          ),
        );
      }
      bloc.append(ul);
      grille.append(bloc);
    }
    section.append(
      grille,
      el('h3', {}, 'Niveaux de préparation'),
      cloner('explication-preparation'),
      el(
        'p',
        { class: 'discret' },
        'Intitulés en anglais (base américaine O*NET 31.0) ; la correspondance avec les métiers français (ROME) est en préparation. Pour en savoir plus sur un métier, son intitulé renvoie à sa fiche O*NET OnLine (en anglais).',
      ),
      el(
        'p',
        {},
        el('strong', {}, 'Et votre personnalité ? '),
        'Elle n’intervient pas dans ce classement. Le site n’affiche pas encore de lien entre vos traits de personnalité et ces métiers : aucune source vérifiée ne permet pour l’instant de l’affirmer.',
      ),
    );
    return section;
  }

  function sectionSuggestions(profil: ProfilPourSuggestions) {
    const { articles, livres } = suggerer(donnees.recommandations, profil);
    const section = el('section', { 'aria-labelledby': 'titre-suggestions', class: 'suggestions' });
    section.append(
      el('h2', { id: 'titre-suggestions' }, 'Pour aller plus loin, selon votre profil'),
      el(
        'p',
        { class: 'phrase-graphique' },
        'Des pistes de lecture choisies par l’équipe du site à partir de règles simples, pas un résultat scientifique. ',
        lien('/suggestions', 'Comment ces suggestions sont choisies'),
      ),
    );
    const raison = (r: string[]) =>
      el('span', { class: 'discret raison' }, `Parce que ${r.join(' ; ')}.`);
    const grille = el('div', { class: 'grille deux' });
    const blocArticles = el(
      'div',
      { class: 'bloc-suggestions' },
      el('h3', {}, 'À lire sur le site'),
    );
    const ulA = el('ul');
    for (const s of articles) {
      const a = donnees.articles[s.id];
      if (!a) continue;
      ulA.append(el('li', {}, lien(a.url, a.titre), ` (${a.badge})`, el('br'), raison(s.raisons)));
    }
    blocArticles.append(
      ulA,
      el('p', { class: 'discret' }, lien('/plan-du-site', 'Tous les articles')),
    );
    const blocLivres = el('div', { class: 'bloc-suggestions' }, el('h3', {}, 'Livres'));
    const ulL = el('ul');
    for (const s of livres) {
      const l = donnees.livres[s.id];
      if (!l) continue;
      ulL.append(
        el(
          'li',
          {},
          lien(`/livres/${s.id}`, l.titre),
          `, ${l.auteurs} (${l.etiquette})`,
          el('br'),
          raison(s.raisons),
        ),
      );
    }
    blocLivres.append(
      ulL,
      el('p', { class: 'discret' }, lien('/livres', 'Tous les livres conseillés')),
    );
    grille.append(blocArticles, blocLivres);
    section.append(grille);
    return section;
  }

  const etat = lireEtat();
  const demande = new URLSearchParams(window.location.search).get('parcours');
  const idParcours = demande === 'rapide' || demande === 'complet' ? demande : etat.parcours;
  const parcours = donnees.parcours.find((p) => p.id === idParcours);

  if (zone && parcours) {
    const qs = parcours.questionnaires
      .map((id) => donnees.questionnaires.find((q) => q.id === id))
      .filter((q): q is QuestionnaireClient => q !== undefined);
    const manquantes = qs.reduce(
      (n, q) => n + q.items.length - compterReponses(q, etat.reponses),
      0,
    );
    const contenu: Node[] = [];
    const entete = el(
      'p',
      { class: 'avertissement' },
      el('strong', {}, `${parcours.nom}. `),
      parcours.precision === 'indicative'
        ? 'Précision indicative : moins de questions par échelle et pas de facettes. '
        : 'Précision plus fine : davantage de questions par échelle et 30 facettes de personnalité. ',
      `Questionnaires : ${qs.map((q) => q.nom).join(' et ')}.`,
    );
    contenu.push(entete);
    if (manquantes > 0) {
      contenu.push(
        el(
          'p',
          {},
          `Il reste ${manquantes} question(s) sans réponse. `,
          lien(`/questionnaire/${parcours.id}`, 'Reprendre le questionnaire'),
          '.',
        ),
      );
    } else {
      const deux = el('div', { class: 'grille deux' });
      let metiers: Node | null = null;
      let codeInterets = '';
      const pourSuggestions: ProfilPourSuggestions = { traits: {}, riasec: null, riasecMax: 0 };
      for (const q of qs) {
        if (q.modele === 'big-five') {
          deux.prepend(sectionPersonnalite(q, etat.reponses));
          const domaines = calculerProfil(q, etat.reponses).domaines;
          for (const { trait } of donnees.traits) {
            pourSuggestions.traits[trait] = domaines[trait]?.valeur ?? null;
          }
        } else {
          const { section, scores } = sectionInterets(q, etat.reponses);
          deux.append(section);
          if (scores) {
            metiers = sectionMetiers(scores);
            codeInterets = codeRiasec(scores).code;
            pourSuggestions.riasec = scores;
            pourSuggestions.riasecMax = calculerProfil(q, etat.reponses).domaines['R']?.max ?? 0;
          }
        }
      }
      const premieres = codeInterets
        .slice(0, 2)
        .split('')
        .map((l) => RIASEC_NOMS[l as (typeof RIASEC)[number]].nomFr.toLowerCase());
      contenu.push(
        el(
          'aside',
          { class: 'essentiel-resultats', 'aria-label': 'L’essentiel' },
          el('p', { class: 'titre-essentiel' }, 'L’essentiel'),
          el(
            'p',
            {},
            premieres.length === 2
              ? `Vos intérêts les plus marqués sont de type ${premieres[0]} et ${premieres[1]}. Les familles de métiers ci-dessous partagent cette forme de profil : ce sont des pistes à explorer, pas des destinations.`
              : 'Voici une photographie de votre personnalité et de vos intérêts aujourd’hui : un point de départ pour réfléchir, pas un verdict.',
          ),
        ),
        deux,
      );
      if (metiers) contenu.push(metiers);
      contenu.push(sectionSuggestions(pourSuggestions));
      if (parcours.id === 'rapide') {
        contenu.push(
          el(
            'p',
            { class: 'avertissement' },
            'Pour un profil plus précis, avec les 30 facettes de personnalité, vous pouvez passer le ',
            lien('/questionnaire/complet', 'parcours complet'),
            '. Les questions communes aux deux parcours seront reprises.',
          ),
        );
      }
      contenu.push(
        el(
          'p',
          { class: 'aide-resultats' },
          'Ces questions remuent parfois beaucoup. Si vous souhaitez en parler, des personnes peuvent vous écouter et vous accompagner : ',
          lien('/besoin-d-en-parler', 'Besoin d’en parler ?'),
        ),
      );
    }
    zone.replaceChildren(...contenu);
  }

  document.querySelector('#effacer')?.addEventListener('click', () => {
    effacerTout();
    window.location.assign('/resultats');
  });
</script>

