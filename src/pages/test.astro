---
import Base from '../layouts/Base.astro';
import Avertissement from '../components/Avertissement.astro';
import { chargerContenu } from '../lib/contenu';

const { items } = await chargerContenu();
// Ordre de présentation : celui du fichier items.json.
const libelles = [
  "Pas du tout d'accord",
  "Plutôt pas d'accord",
  'Ni en accord ni en désaccord',
  "Plutôt d'accord",
  "Tout à fait d'accord",
];
---

<Base titre="Le questionnaire" description="Questionnaire de personnalité Big Five (prototype).">
  <h1>Le questionnaire</h1>
  <Avertissement>
    <p>
      Pour chaque affirmation, indiquez dans quelle mesure elle vous décrit tel que vous êtes
      généralement aujourd'hui, et non tel que vous aimeriez être.
    </p>
  </Avertissement>
  <p class="avertissement">
    <strong>Prototype :</strong> {items.length} items d'exemple, traduits par le projet (traduction
    non validée).
  </p>
  <noscript>
    <p class="avertissement">
      Le calcul des résultats se fait dans votre navigateur et nécessite JavaScript. Vous pouvez
      lire les affirmations, mais pas obtenir vos scores sans JavaScript.
    </p>
  </noscript>
  <form id="questionnaire" action="/resultats" method="get">
    {items.map((item, index) => (
      <fieldset>
        <legend>
          {index + 1}. {item.data.texte_fr}
        </legend>
        {libelles.map((libelle, i) => (
          <label>
            <input type="radio" name={item.id} value={i + 1} required />
            {libelle}
          </label>
        ))}
      </fieldset>
    ))}
    <p id="message-erreur" role="alert"></p>
    <button class="bouton" type="submit">
      Voir mes résultats
    </button>
  </form>
</Base>

<script>
  import { enregistrerReponses } from '../lib/stockage';

  const formulaire = document.querySelector<HTMLFormElement>('#questionnaire');
  formulaire?.addEventListener('submit', (evenement) => {
    evenement.preventDefault();
    const donnees = new FormData(formulaire);
    const reponses: Record<string, number> = {};
    for (const [cle, valeur] of donnees.entries()) {
      reponses[cle] = Number(valeur);
    }
    enregistrerReponses(reponses);
    window.location.assign('/resultats');
  });
</script>

<style>
  fieldset {
    border: 1px solid var(--couleur-bordure);
    margin-block: var(--espace);
  }
  label {
    display: block;
    padding-block: 0.3rem;
  }
</style>
