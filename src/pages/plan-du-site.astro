---
import Base from '../layouts/Base.astro';
import { chargerContenu } from '../lib/contenu';

const { traits, situations, philosophie, metiers, parcours } = await chargerContenu();
---

<Base
  titre="Plan du site"
  description="Toutes les pages de Personalis : le test, les situations, les explications, la philosophie et les informations sur le projet."
  fil={[{ libelle: 'Plan du site' }]}
>
  <h1>Plan du site</h1>
  <div class="grille deux lecture-large">
    <section>
      <h2>Le test</h2>
      <ul>
        <li>
          <a href="/parcours">Choisir un parcours</a>
        </li>
        {parcours.map(({ data }) => (
          <li>
            <a href={`/questionnaire/${data.id}`}>{data.nom}</a>
          </li>
        ))}
        <li>
          <a href="/resultats">Vos résultats</a>
        </li>
      </ul>
      <h2>Ma situation</h2>
      <ul>
        <li>
          <a href="/situations">Toutes les situations</a>
        </li>
        {situations.map(({ id, data }) => (
          <li>
            <a href={`/situations/${id}`}>{data.titre}</a>
          </li>
        ))}
      </ul>
      <h2>Philosophie</h2>
      <ul>
        <li>
          <a href="/philosophie">Philosophie du travail et de la vie</a>
        </li>
        {philosophie.map(({ id, data }) => (
          <li>
            <a href={`/philosophie/${id}`}>{data.titre}</a>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>Comprendre</h2>
      <ul>
        <li>
          <a href="/comprendre">Comprendre</a>
        </li>
        {traits.map(({ id, data }) => (
          <li>
            <a href={`/traits/${id}`}>{data.nom}</a>
          </li>
        ))}
        <li>
          <a href="/comprendre/interets">Les intérêts professionnels (RIASEC)</a>
        </li>
        <li>
          <a href="/la-science">La science derrière le test</a>
        </li>
        <li>
          <a href="/metiers">Fiches métiers d'exemple</a>
        </li>
        {metiers.map(({ id, data }) => (
          <li>
            <a href={`/metiers/${id}`}>{data.intitule}</a>
          </li>
        ))}
      </ul>
      <h2>Le projet</h2>
      <ul>
        <li>
          <a href="/besoin-d-en-parler">Besoin d'en parler ?</a>
        </li>
        <li>
          <a href="/a-propos">À propos et limites</a>
        </li>
        <li>
          <a href="/sources">Sources</a>
        </li>
        <li>
          <a href="/modifications-onet">Modifications et avertissements O*NET</a>
        </li>
        <li>
          <a href="/mentions-legales">Mentions légales</a>
        </li>
      </ul>
    </section>
  </div>
  <p class="discret">
    TODO(domaine) : générer un fichier sitemap.xml (intégration @astrojs/sitemap) une fois le nom de
    domaine connu.
  </p>
</Base>
