---
import Base from '../../layouts/Base.astro';
import Carte from '../../components/Carte.astro';
import Badge from '../../components/Badge.astro';
import Essentiel from '../../components/Essentiel.astro';
import { chargerContenu } from '../../lib/contenu';
import { minutesDeLecture } from '../../lib/lecture';

const { situations } = await chargerContenu();
---

<Base
  titre="Ma situation"
  description="Des repères honnêtes, fondés sur la recherche, pour quatre situations fréquentes : ne pas savoir, se reconvertir, ne plus aimer son travail, choisir ses études."
  fil={[{ libelle: 'Ma situation' }]}
>
  <h1>Ma situation</h1>
  <Essentiel>
    <p>
      Choisissez la situation qui vous ressemble le plus. Chaque page commence simplement, puis
      propose des détails et des références pour qui veut approfondir.
    </p>
  </Essentiel>
  <div class="grille deux">
    {situations.map(({ id, data, body }) => (
      <Carte titre={data.titre} href={`/situations/${id}`}>
        <p slot="haut" class="meta">
          <Badge type={data.badge} />{' '}
          <span class="discret">{minutesDeLecture(data.essentiel, data.comprendre, body)} min</span>
          {data.brouillon && <span class="etiquette">brouillon</span>}
        </p>
        <p>{data.description}</p>
      </Carte>
    ))}
  </div>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    align-items: center;
    margin: 0;
  }
</style>
