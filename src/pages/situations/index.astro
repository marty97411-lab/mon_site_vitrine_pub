---
/**
 * Page d'accueil de « Ma situation » : « Où en êtes-vous ? ». Cartes regroupées par moment de vie
 * (src/data/situations.json), avec accroche et temps de lecture.
 */
import Base from '../../layouts/Base.astro';
import Carte from '../../components/Carte.astro';
import { chargerContenu } from '../../lib/contenu';
import { configSituations, minutes, texteReplie, texteVisible } from '../../lib/situations';

const { situations } = await chargerContenu();
const groupes = configSituations.moments
  .map((m) => ({ ...m, articles: situations.filter((s) => s.data.moment === m.id) }))
  .filter((g) => g.articles.length > 0);
---

<Base
  titre="Ma situation"
  description="Où en êtes-vous ? Des repères honnêtes, fondés sur la recherche, pour les grands moments de la vie professionnelle : études, premier emploi, doutes, transitions, fin de carrière."
  fil={[{ libelle: 'Ma situation' }]}
>
  <h1>Où en êtes-vous ?</h1>
  <p class="intro lecture">{configSituations.introduction}</p>

  {groupes.map((g) => (
    <section
      class:list={['groupe', { transversal: g.id === 'transversal' }]}
      aria-labelledby={`moment-${g.id}`}
    >
      <h2 id={`moment-${g.id}`}>{g.titre}</h2>
      <p class="discret">{g.description}</p>
      <div class="grille deux">
        {g.articles.map(({ id, data, body }) => (
          <Carte titre={data.titre} href={`/situations/${id}`}>
            <p slot="haut" class="meta">
              <span class="discret">
                {minutes(texteVisible(data))} min
                <span class="sr"> de lecture</span> ·{' '}
                {minutes([...texteVisible(data), ...texteReplie(data, body)])} min avec les parties
                dépliées
              </span>
              {data.brouillon && <span class="etiquette">brouillon</span>}
            </p>
            <p>{data.accroche}</p>
          </Carte>
        ))}
      </div>
    </section>
  ))}

  <p class="aide-discrete">
    Une situation pèse trop lourd ? <a href="/besoin-d-en-parler">Besoin d'en parler ?</a>
  </p>
</Base>

<style>
  .intro {
    font-size: 1.1rem;
  }
  .groupe {
    margin-top: var(--espace-5);
  }
  .groupe h2 {
    margin-bottom: var(--espace-1);
  }
  .transversal :global(.carte) {
    background: var(--c-surface-douce);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    align-items: center;
    margin: 0;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .aide-discrete {
    margin-top: var(--espace-5);
    font-size: max(0.95rem, 15px);
    color: var(--c-texte-doux);
  }
</style>
