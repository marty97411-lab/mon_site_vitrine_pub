---
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import Essentiel from '../components/Essentiel.astro';
import Source from '../components/Source.astro';
---

<Base
  titre="Besoin d'en parler ?"
  description="Des conseillers peuvent vous accompagner gratuitement dans vos questions d'orientation : conseil en évolution professionnelle, Onisep, CIO, France Travail."
  fil={[{ libelle: "Besoin d'en parler ?" }]}
>
  <h1>Besoin d'en parler ?</h1>
  <Essentiel>
    <p>
      Vous n'avez pas à réfléchir seul à votre orientation : des conseillers peuvent vous écouter et
      vous accompagner, gratuitement.
    </p>
  </Essentiel>

  <section aria-labelledby="accompagnement">
    <h2 id="accompagnement">Être accompagné dans votre parcours</h2>
    <div class="grille trois">
      <Carte titre="Conseil en évolution professionnelle (CEP)">
        <p>
          Un conseiller vous aide à faire le point et à construire un projet professionnel. Le
          service est gratuit, personnalisé, confidentiel et neutre.
        </p>
        <p>
          <a href="https://mon-cep.org/">mon-cep.org</a>
        </p>
      </Carte>
      <Carte titre="Élèves et étudiants : Onisep et CIO">
        <p>
          Le service « Mon orientation en ligne » de l'Onisep vous met en relation avec des
          conseillers, par téléphone ou par tchat, gratuitement. Les centres d'information et
          d'orientation (CIO) vous reçoivent aussi.
        </p>
        <p>
          <a href="https://www.onisep.fr/mon-orientation-en-ligne">Mon orientation en ligne</a>
        </p>
      </Carte>
      <Carte titre="Demandeurs d'emploi : France Travail">
        <p>
          France Travail accompagne les personnes à la recherche d'un emploi, notamment pour définir
          un projet et trouver une formation.
        </p>
        <p>
          <a href="https://www.francetravail.fr/">francetravail.fr</a>
        </p>
      </Carte>
    </div>
  </section>

  <div class="lecture sources-aide">
    <Source id="mon-cep" />
    <Source id="onisep-moel" />
    <Source id="france-travail" />
  </div>

  <section class="ecoute" aria-labelledby="ecoute">
    <h2 id="ecoute">Si vous traversez un moment très difficile</h2>
    <p>
      Si vous êtes en détresse, si vous avez des pensées suicidaires ou si vous vous inquiétez pour
      un proche, vous pouvez appeler le numéro national de prévention du suicide :
    </p>
    <p class="appel">
      <a href="tel:3114" class="numero">
        3114
      </a>
    </p>
    <p>
      Un professionnel du soin vous écoute, gratuitement, 24 h/24 et 7 j/7, en métropole et en
      outre-mer. Site officiel : <a href="https://3114.fr/">3114.fr</a>
    </p>
    <p>En cas de danger immédiat, appelez le 15 ou le 112.</p>
    <Source id="site-3114" />
    <p class="discret">
      Informations vérifiées sur les sites officiels le 27 novembre 2026. TODO : vérifier les
      numéros d'urgence 15 et 112 sur une source officielle, et ajouter un lien officiel vers
      l'annuaire des CIO.
    </p>
  </section>
</Base>

<style>
  .sources-aide {
    margin-top: var(--espace-3);
  }
  /* Bloc sobre en bas de page : lisible (≥ 15 px, contraste AA), visible sans clic. */
  .ecoute {
    margin-top: var(--espace-6);
    padding-top: var(--espace-3);
    border-top: 1px solid var(--c-bordure);
    max-width: var(--mesure);
    font-size: 0.875rem; /* 15,75 px */
    color: var(--c-texte-doux);
  }
  .ecoute h2 {
    font-size: 1rem;
    color: var(--c-texte);
    margin-top: 0;
  }
  .appel {
    margin: 0;
  }
  .numero {
    font-weight: 700;
    font-size: 1.1rem;
  }
</style>
