---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import FilAriane from '../components/FilAriane.astro';

interface Props {
  titre: string;
  description: string;
  /** Fil d'Ariane (sans l'accueil). Absent sur l'accueil. */
  fil?: { libelle: string; href?: string }[];
  typeOg?: 'website' | 'article';
}

const { titre, description, fil, typeOg = 'website' } = Astro.props;
const NOM = 'Personalis';
const titreComplet = titre === NOM ? NOM : `${titre} · ${NOM}`;
const navigation = [
  { href: '/', libelle: 'Accueil' },
  { href: '/parcours', libelle: 'Le test' },
  { href: '/situations', libelle: 'Ma situation' },
  { href: '/explication', libelle: 'Explication' },
  { href: '/philosophie', libelle: 'Philosophie' },
  { href: '/livres', libelle: 'Livres conseillés' },
  { href: '/a-propos', libelle: 'À propos' },
];
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const actif = (href: string) =>
  href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(`${href}/`);
// TODO(domaine) : renseigner `site` dans astro.config.mjs pour activer l'URL canonique,
// og:url et og:image (qui exigent des adresses absolues).
const urlCanonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageOg = Astro.site ? new URL('/og-personalis.png', Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5A3FD9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {urlCanonique && <link rel="canonical" href={urlCanonique} />}
    <meta property="og:site_name" content={NOM} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={typeOg} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    {urlCanonique && <meta property="og:url" content={urlCanonique} />}
    {imageOg && <meta property="og:image" content={imageOg} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">
      Aller au contenu
    </a>
    <header class="entete">
      <div class="conteneur barre">
        <a class="accueil" href="/" aria-label="Personalis, accueil">
          <Logo />
        </a>
        <nav aria-label="Navigation principale" class="nav-large">
          <ul>
            {navigation.slice(1).map(({ href, libelle }) => (
              <li>
                <a href={href} aria-current={actif(href) ? 'page' : undefined}>
                  {libelle}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <details class="nav-mobile">
          <summary>Menu</summary>
          <nav aria-label="Navigation principale (mobile)">
            <ul>
              {navigation.map(({ href, libelle }) => (
                <li>
                  <a href={href} aria-current={actif(href) ? 'page' : undefined}>
                    {libelle}
                  </a>
                </li>
              ))}
              <li>
                <a href="/besoin-d-en-parler">Besoin d'en parler ?</a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenu" class="conteneur">
      {fil && <FilAriane elements={fil} />}
      <slot />
    </main>

    <footer class="pied">
      <div class="conteneur">
        <div class="pied-ligne">
          <Logo taille={20} />
          <ul class="liens-pied">
            <li>
              <a href="/besoin-d-en-parler">Besoin d'en parler ?</a>
            </li>
            <li>
              <a href="/plan-du-site">Plan du site</a>
            </li>
            <li>
              <a href="/sources">Sources</a>
            </li>
            <li>
              <a href="/glossaire">Glossaire</a>
            </li>
            <li>
              <a href="/a-propos">À propos</a>
            </li>
            <li>
              <a href="/mentions-legales">Mentions légales</a>
            </li>
          </ul>
        </div>
        <p class="licences">
          Vos réponses restent dans votre navigateur. Contient des informations de la base et des
          outils O*NET® (USDOL/ETA), modifiées par le projet ; items IPIP (domaine public).
          <a href="/credits">Crédits et licences</a> ·
          <a href="/modifications-onet">modifications et avertissements O*NET</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--c-fond) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-bordure);
  }
  .barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-3);
    min-height: 4rem;
  }
  .accueil {
    text-decoration: none;
  }
  .nav-large {
    display: none;
  }
  .nav-large ul,
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-large ul {
    display: flex;
    gap: var(--espace-4);
  }
  .nav-large a,
  .nav-mobile a {
    color: var(--c-texte);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
  }
  .nav-large a:hover,
  .nav-large a[aria-current='page'] {
    border-bottom-color: var(--c-primaire);
  }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    border: 1px solid var(--c-bordure);
    background: var(--c-surface);
    border-radius: var(--rayon-pilule);
    padding: 0.4rem 1rem;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile[open] nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-bordure);
    box-shadow: var(--ombre);
    padding: var(--espace-2) var(--espace-3) var(--espace-3);
  }
  .nav-mobile li a {
    display: block;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--c-bordure);
  }
  .nav-mobile a[aria-current='page'] {
    color: var(--c-primaire);
  }
  @media (min-width: 64rem) {
    .nav-large {
      display: block;
    }
    .nav-mobile {
      display: none;
    }
  }
  .pied {
    margin-top: var(--espace-6);
    border-top: 1px solid var(--c-bordure);
    padding-block: var(--espace-3);
    font-size: 0.85rem;
    color: var(--c-texte-doux);
  }
  .pied-ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-2) var(--espace-4);
  }
  .pied-ligne :global(.logo-texte) {
    font-size: 1rem;
  }
  .liens-pied {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-1) var(--espace-3);
  }
  .liens-pied a,
  .licences a {
    color: var(--c-texte-doux);
  }
  .licences {
    margin: var(--espace-2) 0 0;
    max-width: none;
  }
</style>
