{
  "name": "orientation-personnalite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site d'aide à la réflexion sur l'orientation professionnelle, fondé sur le Big Five (IPIP) et le modèle RIASEC (O*NET).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:onet": "node scripts/import-onet.mjs",
    "doc:sources": "node scripts/doc-sources.mjs && prettier --write docs/sources.md",
    "import:fr": "node scripts/import-fr.mjs && prettier --write src/data/fr"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-astro": "^1.1.2",
    "fflate": "^0.8.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
